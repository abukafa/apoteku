DATABASE_URL=postgres://postgres:postgres@localhost:5432/apoteku
PORT=3001
NODE_ENV=development

# Google OAuth Credentials
# Masukkan Client ID & Secret dari Google Cloud Console:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_GOOGLE_CLIENT_ID=

# Base URL API Backend untuk Frontend (kosongkan saat dev lokal untuk memakai proxy Vite)
PUBLIC_API_URL=

# Opsional: Override path absolut direktori penyimpanan upload media
UPLOADS_DIR=
