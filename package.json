{
  "name": "apoteku-monorepo",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --ui=stream",
    "start": "turbo run dev --ui=stream",
    "dev:bun": "bun --filter @apoteku/backend --filter @apoteku/web --parallel run dev",
    "build": "turbo run build && node -e \"const fs=require('fs');if(fs.existsSync('apps/web/.vercel/output')){fs.rmSync('.vercel/output',{recursive:true,force:true});fs.mkdirSync('.vercel',{recursive:true});fs.cpSync('apps/web/.vercel/output','.vercel/output',{recursive:true,verbatimSymlinks:true});}\"",
    "check": "turbo run check",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  }
}
