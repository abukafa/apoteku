{
  "name": "apoteku-monorepo",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build && node -e \"const fs=require('fs'),{execSync}=require('child_process');if(fs.existsSync('apps/web/.vercel/output')){fs.mkdirSync('.vercel',{recursive:true});fs.rmSync('.vercel/output',{recursive:true,force:true});if(process.platform!=='win32'){execSync('cp -a apps/web/.vercel/output .vercel/output');}else{fs.renameSync('apps/web/.vercel/output','.vercel/output');}}\"",
    "check": "turbo run check",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  }
}
