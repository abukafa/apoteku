{
  "name": "@apoteku/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client-indexeddb": "./src/client-indexeddb.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "db:generate": "bun --env-file=../../.env x drizzle-kit generate",
    "db:push": "bun --env-file=../../.env x drizzle-kit push",
    "db:migrate": "bun --env-file=../../.env x drizzle-kit migrate",
    "db:studio": "bun --env-file=../../.env x drizzle-kit studio",
    "migrate:master": "bun --env-file=../../.env src/scripts/migrate-master-data.ts",
    "migrate:purchases": "bun --env-file=../../.env src/scripts/migrate-purchases.ts",
    "migrate:sales": "bun --env-file=../../.env src/scripts/migrate-sales.ts",
    "cleanup:units": "bun --env-file=../../.env src/scripts/cleanup-units-and-backfill-hpp.ts",
    "db:reset-transactions": "bun --env-file=../../.env src/scripts/reset-transactions.ts"
  },
  "dependencies": {
    "dexie": "^4.0.10",
    "drizzle-orm": "^0.45.4",
    "papaparse": "^5.7.0",
    "postgres": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.7.0"
  }
}
